# Google OAuth2 설정
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT 설정 (최소 256비트 이상의 랜덤 문자열 사용)
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-at-least-256-bits

# 데이터베이스 설정
DB_URL=jdbc:postgresql://localhost:5432/portket
DB_USERNAME=portket_user
DB_PASSWORD=your-database-password

# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 애플리케이션 설정
APP_COOKIE_SECURE=true  # 프로덕션에서는 true, 개발에서는 false
APP_FRONTEND_URL=https://your-frontend-domain.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
